# Auth (change JWT_SECRET and ADMIN_PASSWORD in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# FastAPI backend
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RESULTS_DIR=results
UPLOADS_DIR=uploads

# PostgreSQL
POSTGRES_USER=labcd
POSTGRES_PASSWORD=labcd
POSTGRES_DB=labcd
POSTGRES_PORT=5432
# Local (API on host): use localhost. Docker Compose overrides this for the api service.
DATABASE_URL=postgresql+psycopg://labcd:labcd@localhost:5432/labcd

# Optional LLM catalog (used by Plans admin UI model lists)
# OPENAI_API_KEY=
# NVIDIA_API_KEY=

# DB pool / API concurrency (optional)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
